# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Node
node_modules/
dist/
*.tsbuildinfo

# Local state / secrets — never commit
.env
*.db
*.sqlite3
# itkdb HTTP response cache — may hold real PDB data (hard rule #3)
.webcache/

# Read-only reference, not part of the product
references/

# OS / editor noise
.DS_Store
Thumbs.db

# Dev-server logs
*.log

# Desktop build artifacts (Tauri / PyInstaller)
desktop/build/
desktop/src-tauri/target/
# The sidecar is a 20 MB build output, rebuilt by desktop/build-sidecar.py
desktop/src-tauri/binaries/*.exe
desktop/src-tauri/binaries/itkflow-server-*
desktop/src-tauri/gen/

# Locally mirrored PDB attachments — real production images, never commit
attachments/
backend/attachments/
.serena/

# Personal Claude Code overrides — never commit
.claude/settings.local.json
