# Copy to deploy/.env and fill in. Never commit the .env file.

# This repository ships itkView. Keep this explicit so API, frontend and any
# accidentally started worker all select the same fail-closed product policy.
ITKFLOW_PRODUCT_VARIANT=view

# Local Postgres (required). This deployment uses its own itkview database and
# named volume; do not point it at an itkFlow database.
POSTGRES_PASSWORD=

# Local wall-clock timezone of this institute deployment. Scheduled-sync
# windows and weekdays use it; replace Etc/UTC, for example with Europe/Berlin.
TZ=Etc/UTC

# Required server master key for encrypting each account's personal PDB codes.
# Generate a new key for this itkView deployment; do not copy itkFlow's .env or
# key. Keep it stable and back it up like the database. Example:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ITKFLOW_PDB_CREDENTIAL_ENCRYPTION_KEY=

# There is no PDB test server; the only real instance is production. Compose
# enables production READS by default (docs/09): nothing contacts the PDB until
# a signed-in person connects personal access codes. itkView rejects PDB
# writes completely (pdb_write_scope=disabled).
# Uncomment to run a deployment that reaches no PDB at all:
#ITKFLOW_PDB_INSTANCE=offline

# Write sinks remain off even if an old environment contains broader values.
ITKFLOW_PDB_WRITE_SCOPE=disabled
ITKFLOW_ALLOW_PDB_WRITES=false
ITKFLOW_OUTBOX_PROCESSOR=off
ITKFLOW_REMINDER_SCHEDULER=off

# Retry budget per PDB listing page during component syncs (default 3).
# Raise it on an unreliable connection; retries back off exponentially.
#ITKFLOW_SYNC_PAGE_MAX_ATTEMPTS=5

# Operations Health marks sync heartbeats older than this as stale (optional;
# default 180 seconds).
#ITKFLOW_OPS_HEARTBEAT_STALE_SECONDS=180
