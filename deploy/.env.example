# Copy to deploy/.env and fill in. Never commit the .env file.

# Local Postgres (required)
POSTGRES_PASSWORD=

# PDB access codes (optional — only needed for live sync and outbox writes).
# Personal ITk PDB credentials — fill these in your own deploy/.env, never
# here. This example file must stay empty (hard rule #3: no secrets in repo).
ITKFLOW_ITKDB_ACCESS_CODE1=
ITKFLOW_ITKDB_ACCESS_CODE2=

# There is no PDB test server. Reaching the production PDB requires BOTH
# opt-ins below, deliberately set by a human (see docs/09 + ADR 003).
# Reads: component sync, browsing. Writes stay confined to itkFlow-registered
# DUMMY-batch test components (pdb_write_scope=dummy_only) even then.
#ITKFLOW_PDB_INSTANCE=production
#ITKFLOW_ALLOW_PRODUCTION=true

# Extra opt-in read only by the DUMMY write E2E test (pytest -m pdb_write).
# Set it for that run, then remove it again.
#ITKFLOW_ALLOW_PDB_WRITES=true

# Async outbox worker: seconds between polling cycles (optional).
ITKFLOW_WORKER_POLL_SECONDS=5
