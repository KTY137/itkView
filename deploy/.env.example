# Copy to deploy/.env and fill in. Never commit the .env file.

# Local Postgres (required)
POSTGRES_PASSWORD=

# PDB test-instance access codes (optional — only needed for live sync and
# outbox uploads). Personal/sandbox credentials for the PDB *test* instance
# https://itkpd-test.unicorncollege.cz — fill these in your own deploy/.env,
# never here. This example file must stay empty (hard rule #3: no secrets in
# the repo).
ITKFLOW_ITKDB_ACCESS_CODE1=
ITKFLOW_ITKDB_ACCESS_CODE2=

# Async outbox worker: seconds between polling cycles (optional).
ITKFLOW_WORKER_POLL_SECONDS=5

# Note: there is deliberately no production PDB setting in this file.
