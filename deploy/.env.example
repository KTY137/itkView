# Copy to deploy/.env and fill in. Never commit the .env file.

# Local Postgres (required)
POSTGRES_PASSWORD=

# Required server master key for encrypting each account's personal PDB codes.
# Generate once, keep it stable and back it up like the database. Example:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ITKFLOW_PDB_CREDENTIAL_ENCRYPTION_KEY=

# There is no PDB test server; the only real instance is production. Compose
# enables production READS by default (docs/09): nothing contacts the PDB until
# a signed-in person connects their own access codes, and writes stay confined
# to itkFlow-registered DUMMY-batch test components (pdb_write_scope=dummy_only).
# Uncomment to run a deployment that reaches no PDB at all:
#ITKFLOW_PDB_INSTANCE=offline

# Extra opt-in read only by the DUMMY write E2E test (pytest -m pdb_write).
# Set it for that run, then remove it again.
#ITKFLOW_ALLOW_PDB_WRITES=true

# Async outbox worker: seconds between polling cycles (optional).
ITKFLOW_WORKER_POLL_SECONDS=5

# Which process submits approved outbox actions. Compose runs the standalone
# worker service, so the default is right here; the desktop bundle sets "app"
# because it ships a single process (docs/11).
#ITKFLOW_OUTBOX_PROCESSOR=worker

# Retry budget per PDB listing page during component syncs (default 3).
# Raise it on an unreliable connection; retries back off exponentially.
#ITKFLOW_SYNC_PAGE_MAX_ATTEMPTS=5
# Operations Health marks worker/scheduler heartbeats older than this as stale.
# Keep it above both configured poll intervals (optional; default 180 seconds).
#ITKFLOW_OPS_HEARTBEAT_STALE_SECONDS=180

# Timeout for one outbound notification webhook POST (Mattermost etc.),
# used by the reminder tick and the admin test endpoint (optional).
#ITKFLOW_NOTIFY_TIMEOUT_SECONDS=10

# Which process fires due reminders: "worker" (default, correct for Compose —
# it runs one), "app" (the API ticks them; the desktop bundle and the dev
# launcher set this themselves because they run no worker) or "off".
# Configure exactly one ticker per deployment (docs/11).
#ITKFLOW_REMINDER_SCHEDULER=worker
#ITKFLOW_REMINDER_POLL_SECONDS=60
